{
  "name": "upyun",
  "description": "部署到又拍云SSL证书库",
  "version": "1.0.0",
  "author": "allinssl",
  "config": [
    {
      "name": "username",
      "type": "string",
      "description": "又拍云操作员账号（子账号，非主账号）",
